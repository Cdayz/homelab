                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "loki",
                "uid": "loki"
            },
            "targets": [
                {
                    "refId": "A",
                    "legendFormat": "{{geoip_country_name}}",
                    "expr": "sum by (geoip_country_name) (count_over_time({job=\"systemd-journal\",host=\"nucbox\",unit=~\"sshd.service|ssh.service\",geoip_country_name!=\"\"} |~ \"Failed password|Invalid user|authentication failure|PAM.*authentication failure\" [$__interval]))"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
