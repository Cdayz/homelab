                    "mode": "multi",
                    "sort": "desc"
                }
            }
        },
        {
            "id": 6,
            "type": "timeseries",
            "title": "SSH auth by continent",
            "gridPos": {
                "x": 12,
                "y": 4,
                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "loki",
                "uid": "loki"
            },
            "targets": [
                {
                    "refId": "A",
                    "legendFormat": "{{geoip_continent_name}} failed",
                    "expr": "sum by (geoip_continent_name) (count_over_time({job=\"systemd-journal\",host=\"nucbox\",unit=~\"sshd.service|ssh.service\",geoip_continent_name!=\"\"} |~ \"Failed password|Invalid user|authentication failure|PAM.*authentication failure\" [$__interval]))"
                },
                {
                    "refId": "B",
                    "legendFormat": "{{geoip_continent_name}} accepted",
                    "expr": "sum by (geoip_continent_name) (count_over_time({job=\"systemd-journal\",host=\"nucbox\",unit=~\"sshd.service|ssh.service\",geoip_continent_name!=\"\"} |~ \"Accepted publickey|Accepted password|Accepted keyboard-interactive\" [$__interval]))"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom",
                    "calcs": [
                        "lastNotNull",
                        "sum"
                    ]
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            }
        },
