{
    "uid": "homelab-node-security-auditd",
    "title": "Homelab / Node Security Auditd",
    "tags": [
        "homelab",
        "node",
        "security",
        "auditd"
    ],
    "timezone": "browser",
    "schemaVersion": 41,
    "version": 3,
    "refresh": "10s",
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "panels": [
        {
            "id": 1,
            "type": "stat",
            "title": "Audit events",
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 6,
                "h": 4
            },
            "datasource": {
                "type": "loki",
                "uid": "loki"
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(count_over_time({job=\"systemd-journal\",host=\"nucbox\"} |~ \"audit\" [$__range]))"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 50
                            },
                            {
                                "color": "red",
                                "value": 200
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "values": false,
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": ""
                }
            }
        },
        {
            "id": 2,
            "type": "stat",
            "title": "sudo executions",
            "gridPos": {
                "x": 6,
                "y": 0,
                "w": 6,
                "h": 4
            },
            "datasource": {
                "type": "loki",
                "uid": "loki"
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(count_over_time({job=\"systemd-journal\",host=\"nucbox\"} |~ \"audit.*sudo\" [$__range]))"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 5
                            },
                            {
                                "color": "red",
                                "value": 20
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "values": false,
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": ""
                }
            }
        },
        {
            "id": 3,
            "type": "stat",
            "title": "execve activity",
            "gridPos": {
                "x": 12,
                "y": 0,
                "w": 6,
                "h": 4
            },
            "datasource": {
                "type": "loki",
                "uid": "loki"
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(count_over_time({job=\"systemd-journal\",host=\"nucbox\"} |~ \"audit.*execve\" [$__range]))"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 100
                            },
                            {
                                "color": "red",
                                "value": 500
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "values": false,
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": ""
                }
            }
        },
        {
            "id": 4,
            "type": "stat",
            "title": "permission changes",
            "gridPos": {
                "x": 18,
                "y": 0,
                "w": 6,
                "h": 4
            },
            "datasource": {
                "type": "loki",
                "uid": "loki"
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(count_over_time({job=\"systemd-journal\",host=\"nucbox\"} |~ \"audit.*chmod|audit.*chown\" [$__range]))"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 20
                            },
                            {
                                "color": "red",
                                "value": 100
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "values": false,
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": ""
                }
            }
        },
        {
            "id": 5,
            "type": "timeseries",
            "title": "audit activity timeline",
            "gridPos": {
                "x": 0,
                "y": 4,
                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "loki",
                "uid": "loki"
            },
            "targets": [
                {
                    "refId": "A",
                    "legendFormat": "audit events",
                    "expr": "sum(count_over_time({job=\"systemd-journal\",host=\"nucbox\"} |~ \"audit\" [$__interval]))"
                },
                {
                    "refId": "B",
                    "legendFormat": "sudo",
                    "expr": "sum(count_over_time({job=\"systemd-journal\",host=\"nucbox\"} |~ \"audit.*sudo\" [$__interval]))"
                },
                {
                    "refId": "C",
                    "legendFormat": "execve",
                    "expr": "sum(count_over_time({job=\"systemd-journal\",host=\"nucbox\"} |~ \"audit.*execve\" [$__interval]))"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0
                },
                "overrides": []
            }
        },
        {
            "id": 6,
            "type": "timeseries",
            "title": "permission changes timeline",
            "gridPos": {
                "x": 12,
                "y": 4,
                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "loki",
                "uid": "loki"
            },
            "targets": [
                {
                    "refId": "A",
                    "legendFormat": "chmod/chown",
                    "expr": "sum(count_over_time({job=\"systemd-journal\",host=\"nucbox\"} |~ \"audit.*chmod|audit.*chown\" [$__interval]))"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0
                },
                "overrides": []
            }
        },
        {
            "id": 7,
            "type": "bargauge",
            "title": "top executed binaries",
            "gridPos": {
                "x": 0,
                "y": 12,
                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "loki",
                "uid": "loki"
            },
            "targets": [
                {
                    "refId": "A",
                    "legendFormat": "{{exe}}",
                    "expr": "topk(10, sum by (exe) (count_over_time({job=\"systemd-journal\",host=\"nucbox\"} | regexp \"exe=\\\"(?P<exe>[^\\\"]+)\\\"\" [$__range])))"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0
                },
                "overrides": []
            }
        },
        {
            "id": 8,
            "type": "logs",
            "title": "auditd logs",
            "gridPos": {
                "x": 0,
                "y": 20,
                "w": 24,
                "h": 12
            },
            "datasource": {
                "type": "loki",
                "uid": "loki"
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "{job=\"systemd-journal\",host=\"nucbox\"} |~ \"audit\""
                }
            ],
            "options": {
                "showTime": true,
                "showLabels": true,
                "wrapLogMessage": true,
                "sortOrder": "Descending"
            }
        }
    ]
}