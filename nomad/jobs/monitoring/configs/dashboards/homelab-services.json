{
  "uid": "homelab-services",
  "title": "Homelab / Services",
  "tags": ["homelab", "nomad", "observability", "gitops"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Down scrape targets",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up == 0)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Nomad running allocs",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "nomad_client_allocs_running"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Nomad failed allocs",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "nomad_client_allocs_failed"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Loki ingestion bytes/s",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(loki_distributor_bytes_received_total[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Bps" },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Prometheus target health",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{job}} / {{instance}}",
          "expr": "up"
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Nomad allocation errors",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"nomad-alloc\"} |~ \"(?i)error|panic|fatal|failed\""
        }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Systemd errors",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"systemd-journal\"} |~ \"(?i)error|failed|panic|fatal\""
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Alloy logs",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{unit=\"alloy.service\"}"
        }
      ]
    }
  ]
}