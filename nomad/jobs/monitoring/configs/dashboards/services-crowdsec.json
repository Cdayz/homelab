{
    "uid": "services-crowdsec",
    "title": "Services / CrowdSec",
    "tags": [
        "crowdsec",
        "services",
        "security"
    ],
    "timezone": "browser",
    "schemaVersion": 41,
    "version": 1,
    "refresh": "10s",
    "time": {
        "from": "now-24h",
        "to": "now"
    },
    "templating": {
        "list": []
    },
    "panels": [
        {
            "id": 1,
            "type": "stat",
            "title": "CrowdSec Up",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 0,
                "y": 0
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "up{job=\"crowdsec\"}"
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                },
                "orientation": "horizontal",
                "colorMode": "background",
                "graphMode": "none"
            },
            "fieldConfig": {
                "defaults": {
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": {
                                    "text": "DOWN"
                                },
                                "1": {
                                    "text": "UP"
                                }
                            }
                        }
                    ],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red"
                            },
                            {
                                "color": "green",
                                "value": 1
                            }
                        ]
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 2,
            "type": "stat",
            "title": "Journal Lines/sec",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 6,
                "y": 0
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(rate(cs_journalctlsource_hits_total[5m]))"
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                },
                "orientation": "horizontal",
                "colorMode": "value",
                "graphMode": "area"
            }
        },
        {
            "id": 3,
            "type": "stat",
            "title": "Parser Success/sec",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 12,
                "y": 0
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(rate(cs_parser_hits_ok_total[5m]))"
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                },
                "orientation": "horizontal",
                "colorMode": "value",
                "graphMode": "area"
            }
        },
        {
            "id": 4,
            "type": "stat",
            "title": "Parser Failures/sec",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 18,
                "y": 0
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(rate(cs_parser_hits_ko_total[5m]))"
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                },
                "orientation": "horizontal",
                "colorMode": "background",
                "graphMode": "area"
            }
        },
        {
            "id": 5,
            "type": "timeseries",
            "title": "Buckets Instantiated",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 4
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by(name) (increase(cs_bucket_instantiation_total[1h]))",
                    "legendFormat": "{{name}}"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "linear",
                        "fillOpacity": 10,
                        "showPoints": "never"
                    }
                },
                "overrides": []
            }
        },
        {
            "id": 6,
            "type": "timeseries",
            "title": "Bucket Pours",
            "gridPos": {
                "h": 8,
