                    "expr": "sum(count_over_time({job=\"systemd-journal\",host=\"nucbox\",unit=~\"sshd.service|ssh.service\"} |~ \"Accepted publickey|Accepted password|Accepted keyboard-interactive\" [$__interval]))"
